# ==============================================================================
# LedgerGuard Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# The default values and credentials below (e.g. passwords, secrets, tokens)
# are strictly for ISOLATED LOCAL DEVELOPMENT AND TESTING.
#
# DO NOT USE THESE CREDENTIALS IN PRODUCTION OR SHARED ENVIRONMENTS.
# Copy this file to .env for local overrides (real .env files are git-ignored).
# All database ports bind to loopback (127.0.0.1) by default in docker-compose.yml.
# ==============================================================================

# Environment profile (local, test, production)
LEDGERGUARD_ENV=local
FAULT_INJECTION_ENABLED=false

# Coordinator Database (Host port 5442 avoids conflicts with default 5432)
COORDINATOR_DB_HOST=localhost
COORDINATOR_DB_PORT=5442
COORDINATOR_DB_NAME=coordinator_db
COORDINATOR_DB_USER=ledgerguard_app
COORDINATOR_DB_PASSWORD=ledgerguard_app_secret
COORDINATOR_DB_URL=postgresql://ledgerguard_app:ledgerguard_app_secret@localhost:5442/coordinator_db

# Admin/Migration URL for Coordinator (owner credentials for running migrations)
COORDINATOR_ADMIN_DB_URL=postgresql://ledgerguard_admin:ledgerguard_admin_secret@localhost:5442/coordinator_db

# Participant Ledger 1 Database
LEDGER1_DB_HOST=localhost
LEDGER1_DB_PORT=5443
LEDGER1_DB_NAME=ledger1_db
LEDGER1_DB_USER=ledgerguard_app
LEDGER1_DB_PASSWORD=ledgerguard_app_secret
LEDGER1_DB_URL=postgresql://ledgerguard_app:ledgerguard_app_secret@localhost:5443/ledger1_db
LEDGER1_ADMIN_DB_URL=postgresql://ledgerguard_admin:ledgerguard_admin_secret@localhost:5443/ledger1_db

# Participant Ledger 2 Database
LEDGER2_DB_HOST=localhost
LEDGER2_DB_PORT=5444
LEDGER2_DB_NAME=ledger2_db
LEDGER2_DB_USER=ledgerguard_app
LEDGER2_DB_PASSWORD=ledgerguard_app_secret
LEDGER2_DB_URL=postgresql://ledgerguard_app:ledgerguard_app_secret@localhost:5444/ledger2_db
LEDGER2_ADMIN_DB_URL=postgresql://ledgerguard_admin:ledgerguard_admin_secret@localhost:5444/ledger2_db

# Single Database Reference Mode (Core Edition)
CORE_DB_URL=postgresql://ledgerguard_app:ledgerguard_app_secret@localhost:5442/coordinator_db
CORE_ADMIN_DB_URL=postgresql://ledgerguard_admin:ledgerguard_admin_secret@localhost:5442/coordinator_db

# Service Ports & URLs
COORDINATOR_PORT=8010
COORDINATOR_URL=http://localhost:8010
LEDGER1_PORT=8011
LEDGER1_URL=http://localhost:8011
LEDGER2_PORT=8012
LEDGER2_URL=http://localhost:8012
CONSOLE_PORT=3300

# Authentication & Internal Service Token
INTERNAL_SERVICE_SECRET=ledgerguard_internal_secret_token_change_in_prod
API_BEARER_TOKEN=ledgerguard_operator_demo_token

# Trusted Frontend Origins & Proxy Security
# Comma-separated complete origins (scheme://host[:port]). Required outside local/test.
# Defaults in local/test: http://localhost:3300,http://127.0.0.1:3300,http://localhost:8010,http://127.0.0.1:8010
LEDGERGUARD_TRUSTED_ORIGINS=http://localhost:3300,http://127.0.0.1:3300

# Cookie Security Mode: true to force Secure cookies, false for local HTTP, omit to auto-determine
# (In production, Secure cookies are always enforced regardless of forwarded headers)
# LEDGERGUARD_COOKIE_SECURE=false

# Trusted reverse-proxy IP addresses permitted to set X-Forwarded-Proto in local/test
LEDGERGUARD_TRUSTED_PROXIES=127.0.0.1,::1

# Worker and Job Configuration
WORKER_POLL_INTERVAL_MS=200
WORKER_BATCH_SIZE=20
WORKER_LOCK_TIMEOUT_SECONDS=10
